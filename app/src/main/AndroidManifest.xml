<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".dbLocal.InfoQrApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/conaflogo1"
        android:label="@string/app_name"
        android:roundIcon="@drawable/conaflogo1"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParquePumalinApp"
        tools:targetApi="31">
        <activity
            android:name=".activities.AcercaDeActivity"
            android:exported="false" />
        <activity
            android:name=".activities.ConfigActivity"
            android:exported="false" />
        <activity
            android:name=".activities.InfoQR.InfoQrHitoActivity"
            android:exported="false" />
        <activity
            android:name=".activities.InfoQR.InfoQrCampingActivity"
            android:exported="false" />
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Design.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".activities.InfoQR.InfoQrSenderoActivity"
            android:exported="false" />
        <activity
            android:name=".activities.MainActivity"
            android:exported="true">

            <!-- android:theme="@style/Theme.App.SplashScreen"> -->

        </activity>
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="fullSensor"
            tools:ignore="DiscouragedApi"
            tools:replace="screenOrientation" />
    </application>

</manifest>