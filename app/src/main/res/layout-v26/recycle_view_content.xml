<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/st_borde_cafe_redondo"
    android:backgroundTint="@color/fondo_texto"
    android:backgroundTintMode="screen"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_marginBottom="2dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/trailName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sendero Cascadas"
            android:textAppearance="?attr/textAppearanceSubtitle1"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/expandIndicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:padding="4dp"
            android:src="@drawable/ic_arrow_white" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/trailDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="vertical"
        android:paddingTop="15dp"
        android:visibility="visible">

        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAH"
            android:textAlignment="viewStart"
            android:textColor="@color/white"
            android:justificationMode="inter_word"
            />

        <TextView
            android:id="@+id/tvDes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:layout_gravity="center"
            android:text="Desliza para ver más imágenes"
            android:textColor="@color/Amarillo" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/ImgInfo"
            android:layout_width="match_parent"
            android:layout_height="150dp" 
            />

    </LinearLayout>
</LinearLayout>