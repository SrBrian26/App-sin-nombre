<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/img_fondo_principal_volcan"
    tools:context=".activities.InfoQR.InfoQrCampingActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarCamping"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/img_toolbar_tejas_animadas"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/white"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarCamping">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/st_borde_cafe_redondo"
            android:backgroundTintMode="screen"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/DescCamping"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/st_borde_verde_redondo"
                android:backgroundTint="#8B0F0E0E"
                android:backgroundTintMode="screen"
                android:text="Descripción Camping"
                android:textAlignment="viewStart"
                android:textColor="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/PrecioComunitario"
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/st_borde_verde_redondo"
                    android:backgroundTintMode="screen"
                    android:layout_gravity="center"
                    android:layout_marginTop="10dp"
                    android:text="Precio comunitario"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/PrecioPrivado"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/st_borde_verde_redondo"
                    android:backgroundTintMode="screen"
                    android:text="Precio privado"
                    android:layout_marginTop="10dp"
                    android:textColor="@color/white" />
            </LinearLayout>

                <TextView
                    android:id="@+id/SuperficieCamping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/st_borde_verde_redondo"
                    android:backgroundTintMode="screen"
                    android:text="Superficie"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/CapacidadCamping"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/st_borde_verde_redondo"
                    android:backgroundTintMode="screen"
                    android:text="Capacidad"
                    android:layout_marginTop="15dp"
                    android:textColor="@color/white" />

            <ImageView
                android:id="@+id/Clagoblancoid"
                android:layout_width="match_parent"
                android:layout_height="350dp"
                android:background="@drawable/st_borde_cafe_redondo"
                android:backgroundTint="@color/fondo_texto"
                android:backgroundTintMode="screen"/>

            <TextView
                android:id="@+id/RestriccionesCamping"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:background="@drawable/st_borde_rojo_redondo"
                android:backgroundTintMode="screen"
                android:text="Restricciones"
                android:textColor="@color/white" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>