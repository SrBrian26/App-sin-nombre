<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/img_fondo_principal_volcan"
    tools:context=".activities.InfoQR.InfoQrSenderoActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar2"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/img_toolbar_tejas_animadas"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:subtitleTextColor="@color/white"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar2">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/st_borde_cafe_redondo"
            android:backgroundTintMode="screen"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/traerDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/st_borde_verde_redondo"
                android:backgroundTint="@color/fondo_texto"
                android:backgroundTintMode="screen"
                android:text="Descripción"
                android:textAlignment="viewStart"
                android:textColor="@color/white" />

            <ImageView
                android:id="@+id/traerImgPrincipal"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/st_borde_cafe_redondo"
                android:backgroundTintMode="screen"/>

            <TextView
                android:id="@+id/traerDificultad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_gravity=""
                android:background="@drawable/st_borde_verde_redondo"
                android:backgroundTintMode="screen"
                android:text="Dificultad"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/traerLongitud"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/st_borde_verde_redondo"
                android:backgroundTintMode="screen"
                android:text="Longitud"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/traerTiempo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/st_borde_verde_redondo"
                android:backgroundTintMode="screen"
                android:text="Tiempo"
                android:textColor="@color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/traerImgFlora"
                    android:layout_width="170dp"
                    android:layout_height="150dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/st_borde_cafe_redondo"
                    android:backgroundTint="#8B0F0E0E"
                    android:backgroundTintMode="screen" />

                <TextView
                    android:id="@+id/traerFlora"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:layout_weight="1"
                    android:background="@drawable/st_borde_verde_redondo"
                    android:backgroundTintMode="screen"
                    android:layout_gravity="top"
                    android:text="Flora"
                    android:textColor="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/traerRestricciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/st_borde_rojo_redondo"
                android:backgroundTintMode="screen"
                android:text="Restricciones"
                android:textColor="@color/white" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>