<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/img_fondo_hito"
    tools:context=".activities.InfoQR.InfoQrHitoActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarHito"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/img_toolbar_tejas_animadas"
        app:titleTextColor="@color/white"
        app:subtitleTextColor="@color/white"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight" />

    <ScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarHito">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/st_borde_cafe_redondo"
            android:backgroundTintMode="screen"
            android:orientation="vertical"
            android:padding="16dp">

            <ImageView
                android:id="@+id/traerImgPrincipalHito"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@drawable/st_borde_cafe_redondo"
                android:backgroundTintMode="screen" />

            <TextView
                android:id="@+id/traerDescHito"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/st_borde_verde_redondo"
                android:backgroundTintMode="screen"
                android:text="Descripción Hito"
                android:textAlignment="viewStart"
                android:textColor="@color/white" />

            <ImageView
                android:id="@+id/traerImg2Hito"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:layout_marginTop="24dp"
                android:background="@drawable/st_borde_cafe_redondo"
                android:backgroundTintMode="screen" />

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>