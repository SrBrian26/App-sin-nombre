<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"


    android:layout_height="match_parent"
    android:background="@drawable/background_grande_hito"
    tools:context=".activities.InfoQR.InfoQrHitoActivity">


    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbarHito"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:background="@drawable/background_info_hito"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:subtitleTextColor="#070707"
        app:titleTextColor="#EE000000" />


    <ImageView
        android:id="@+id/traerImgPrincipalHito"
        android:layout_width="365dp"
        android:layout_height="200dp"
        android:layout_marginTop="52dp"
        android:background="@drawable/borde_redondo"
        android:backgroundTint="#8B0F0E0E"
        android:backgroundTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.51"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarHito" />

    <ImageView
        android:id="@+id/traerImg2Hito"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="15dp"
        android:background="@drawable/borde_redondo"
        android:backgroundTint="#8B0F0E0E"
        android:backgroundTintMode="multiply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/traerDescHito" />

    <!--
        <TextView
            android:id="@+id/traerRestricciones"
            android:layout_width="365dp"
            android:layout_height="120dp"
            android:layout_marginStart="15dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="15dp"
            android:text="Restricciones"
            android:background="#FFFFFF"
            android:textColor="#EDE5E5"
            android:backgroundTint="#8B0F0E0E"
            android:backgroundTintMode="multiply"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/traerImg2Hito" />
-->
    <TextView
        android:id="@+id/traerDescHito"
        android:layout_width="365dp"
        android:layout_height="150dp"
        android:layout_marginTop="28dp"
        android:autoSizeTextType="none"
        android:background="@drawable/borde_redondo"
        android:backgroundTint="#8B0F0E0E"
        android:backgroundTintMode="screen"
        android:text="DescripciónHito"

        android:textAlignment="viewStart"
        android:textColor="#EDE5E5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/traerImgPrincipalHito" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="76dp"
        android:layout_height="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="672dp"
        android:background="@drawable/borde_redondo"
        android:elevation="5dp"
        android:text="Hito"
        android:textColor="#FFFFFF"
        android:textColorHighlight="#FFFFFF"
        android:textColorHint="#FFFFFF"
        android:textColorLink="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteX="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>